#!/bin/sh
# Reject commits that attribute Cursor Agent as co-author.
# Enable: git config core.hooksPath .githooks

msg_file="$(git rev-parse --git-path COMMIT_EDITMSG)"
if [ -f "$msg_file" ] && grep -qE '^Co-authored-by: Cursor <cursoragent@cursor.com>$' "$msg_file"; then
  echo "pre-commit: remove 'Co-authored-by: Cursor <cursoragent@cursor.com>' from the commit message."
  exit 1
fi

exit 0
