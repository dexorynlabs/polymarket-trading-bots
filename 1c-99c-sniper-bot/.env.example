# sniperbot — the ONLY config file. Copy to .env (gitignored) and edit.
# Variables already set in your shell override this file.
#
#   1. Strategy      SNIPER_MODE is required; the rest is optional.
#   2. Spend rails   optional; the defaults are shown.
#   3. Live account  POLY_* — only for --live / --preflight. Leave EVERY
#                    POLY_* empty for a dry run. Fill in one and the five
#                    secrets become required.
#
# Empty value = use the default. A misspelled SNIPER_* / POLY_* name is an
# error, never a silent default.

# ===========================================================================
# 1. STRATEGY
# ===========================================================================

# REQUIRED. Which token to buy in each btc-updown-5m slot.
#
#   1c   buy the TRAILING token at ~1c. Win ~+99c / lose ~1c per share.
#        Measured on the 1c census: 5 wins in 98 in-band entries
#        (break-even is ~1.07%).
#   99c  buy the LEADING token at ~99c. Win ~+1c / lose ~99c per share.
#        UNMEASURED. Break-even is a ~99.07% win rate: one loss erases ~99
#        wins. Run --dry-run first.
SNIPER_MODE=1c

# burst (default): fire on a Binance burst toward the token we buy.
# calm (99c only): fire while there is no burst against the leader.
SNIPER_TRIGGER=

# Dollars committed per fire. Preset: 1c $10, 99c $20.
# Must buy >= 5 shares at the limit (the venue minimum).
SNIPER_CLIP_USD=

# The standing-ask band to enter at, and the FAK limit price.
# Preset 1c:  0.009 / 0.011 / limit 0.02   (validated to [0.005, 0.10])
# Preset 99c: 0.97  / 0.99  / limit 0.99   (validated to [0.90, 0.999])
SNIPER_ASK_MIN=
SNIPER_ASK_MAX=
SNIPER_LIMIT=

# Halt after this much CLOB-settled loss. Latches until restart.
# Preset: 1c $400, 99c $100. Must be below SNIPER_DAILY_CAP_USD.
SNIPER_LOSS_KILL_USD=

# false = ingest, record books and write telemetry, but never fire.
SNIPER_TICK_ENABLED=

# The burst: >= SNIPER_V_BTC of Binance spot volume in the last
# SNIPER_WINDOW_MS, with >= SNIPER_LEAN_MIN of it pointing one way.
# Presets: 0.5 BTC, 0.6, 1000 ms.
SNIPER_V_BTC=
SNIPER_LEAN_MIN=
SNIPER_WINDOW_MS=

# calm only: veto while >= this much BTC flows against the leader. Preset 0.3.
SNIPER_ADVERSE_MAX_BTC=

# Ignore a held order book older than this. Preset: 1c 15000, 99c 2000.
SNIPER_MAX_BOOK_AGE_MS=

# ===========================================================================
# 2. SPEND RAILS — every cap must be >= one fire (SNIPER_CLIP_USD).
#    RAISE a rail, never shrink the clip: a binding rail censors silently.
# ===========================================================================

# Rolling-24h committed spend. Default 2500 (= 250 fires at $10, 125 at $20).
SNIPER_DAILY_CAP_USD=
# Max open (unsettled) exposure. Default 150.
SNIPER_EXPOSURE_CAP_USD=
# Max commit of a single fire. Default 100.
SNIPER_PER_ORDER_CAP_USD=
# Fault latch, not a rate limiter (the bot fires at most once per slot). Default 20.
SNIPER_FIRE_RATE_PER_MIN=
# Disarm when this slot's book WS has been silent this long, ms. Default 5000.
SNIPER_BOOK_STALE_MS=
# Telemetry only. Leave empty (off).
SNIPER_BOUNDARY_CLOSE_DELAY_MS=

# ===========================================================================
# 3. LIVE ACCOUNT — --live and --preflight only. Use a wallet dedicated to
#    this bot. Collateral is pUSD, not USDC.e. NEVER commit your .env.
# ===========================================================================

# Required for live (no defaults):
POLY_PRIVATE_KEY=          # 0x + 64 hex: the EOA key that controls the proxy wallet
POLY_PROXY_WALLET=         # 0x address of the proxy wallet that holds pUSD
POLY_API_KEY=              # CLOB API key (UUID)
POLY_API_SECRET=           # base64
POLY_API_PASSPHRASE=

# Optional (defaults shown):
POLY_SIGNATURE_TYPE=       # 1 = Magic.link proxy, 2 = Safe, 3 = accounts created 2026-08+
POLY_RPC_URL=              # https://polygon-rpc.com
POLY_RPC_WS_URL=           # optional; checked by --preflight when set
POLY_CHAIN_ID=             # 137
POLY_CLOB_HTTP=            # https://clob.polymarket.com
POLY_CLOB_WS=              # wss://ws-subscriptions-clob.polymarket.com

# Live safety halts (defaults shown):
SNIPER_LIVE_BUY_CAP_USD=        # 150  rolling-24h BUY cap checked by the launch gate
SNIPER_LIVE_DAILY_LOSS_USD=     # 100  halt when 24h ledger P&L < -this
SNIPER_LIVE_LOSS_PER_HOUR_USD=  # 40   halt when losing this much per hour...
SNIPER_LIVE_LOSS_HOURS=         # 2    ...for this many hours in a row

# ===========================================================================
# Not this bot's namespace, but read from the environment too:
# RUST_LOG=info
# RECON_GIT_SHA=        # required by --live: the commit you are running
